# =============================================================================
# Caissa — production environment template.
#
# This file is a TEMPLATE. Do not commit a filled-in copy. In production these
# values come from a secrets manager injected into the environment, never from a
# file in the image. `python scripts/validate_config.py --environment production`
# must pass before a deploy (it checks keys, PostgreSQL, JSON logs and the LLM
# provider).
#
# Production is where the honesty contract matters most: no echo provider, no
# open mode, no SQLite, no text logs.
# =============================================================================

ARGUS_ENV=production
ARGUS_LOG_LEVEL=INFO
ARGUS_LOG_FORMAT=json

# --- API ---------------------------------------------------------------------
ARGUS_API_HOST=0.0.0.0
ARGUS_API_PORT=8000
# Exactly the public web origin(s). Do not use a wildcard.
ARGUS_CORS_ORIGINS=https://argus.example

# --- Database / cache --------------------------------------------------------
# Use the connection pooler URI where one is provided. The API uses a sync
# SQLAlchemy engine, so the psycopg2 scheme is required.
ARGUS_DATABASE_URL=postgresql+psycopg2://argus:INJECTED_SECRET@db:5432/argus
ARGUS_REDIS_URL=redis://:INJECTED_SECRET@redis:6379/0

# --- Engine ------------------------------------------------------------------
ARGUS_STOCKFISH_PATH=/usr/games/stockfish
ARGUS_ENGINE_DEPTH=16
ARGUS_ENGINE_MULTIPV=3
ARGUS_ENGINE_TIMEOUT_SECONDS=30
ARGUS_ENGINE_THREADS=2
ARGUS_ENGINE_HASH_MB=512
ARGUS_ANALYSIS_PROFILE=standard

# --- Auth (REQUIRED; open mode is refused in production) ---------------------
ARGUS_API_KEYS=INJECTED_KEY:operator:operator

# --- Rate limits / resource bounds -------------------------------------------
ARGUS_RATE_LIMIT_ANALYSIS_PER_MINUTE=30
ARGUS_RATE_LIMIT_IMPORT_PER_MINUTE=30
ARGUS_RATE_LIMIT_COACH_PER_MINUTE=20
ARGUS_RATE_LIMIT_UPLOAD_PER_MINUTE=10
ARGUS_RATE_LIMIT_SEARCH_PER_MINUTE=60
ARGUS_ENGINE_MAX_CONCURRENCY=2
ARGUS_ANALYSIS_QUEUE_LIMIT=64
ARGUS_MAX_REQUEST_BYTES=4000000

# --- Feature flags (turn a surface off without a redeploy) -------------------
ARGUS_FEATURE_FLAGS=

# --- LLM coach (a real provider; 'echo' is refused in production) ------------
ARGUS_LLM_PROVIDER=openai
ARGUS_LLM_MODEL=
ARGUS_LLM_API_KEY=INJECTED_SECRET
ARGUS_LLM_BASE_URL=

ARGUS_MODELS_DIR=/app/data/models
NEXT_PUBLIC_API_URL=https://api.argus.example
