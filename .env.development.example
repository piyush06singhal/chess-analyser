# =============================================================================
# Caissa — development environment template.
# Copy to .env for local work:  cp .env.development.example .env
#
# Development is deliberately permissive: no API keys (open mode), text logs,
# the fast analysis profile. Production rules do NOT apply here.
# =============================================================================

ARGUS_ENV=development
ARGUS_LOG_LEVEL=INFO
ARGUS_LOG_FORMAT=text

# --- API / ports -------------------------------------------------------------
ARGUS_API_HOST=0.0.0.0
ARGUS_API_PORT=8002
ARGUS_CORS_ORIGINS=http://localhost:3000,http://localhost:3100

API_HOST_PORT=8002
WEB_HOST_PORT=3100
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6380
REDIS_PASSWORD=argus-dev

# --- Database / cache --------------------------------------------------------
ARGUS_DATABASE_URL=postgresql+psycopg2://argus:argus@localhost:5434/argus
ARGUS_REDIS_URL=redis://:argus-dev@localhost:6380/0

# --- Engine ------------------------------------------------------------------
ARGUS_STOCKFISH_PATH=
ARGUS_ENGINE_DEPTH=12
ARGUS_ENGINE_MULTIPV=3
ARGUS_ENGINE_TIMEOUT_SECONDS=30
ARGUS_ENGINE_THREADS=1
ARGUS_ENGINE_HASH_MB=256
ARGUS_ANALYSIS_PROFILE=standard

# --- Auth (open in development) ---------------------------------------------
# Empty = open mode: every request is the 'local' caller. Never do this in prod.
ARGUS_API_KEYS=

# --- Rate limits (per minute, per caller; 0 = unlimited) ---------------------
ARGUS_RATE_LIMIT_ANALYSIS_PER_MINUTE=30
ARGUS_RATE_LIMIT_IMPORT_PER_MINUTE=30
ARGUS_RATE_LIMIT_COACH_PER_MINUTE=20
ARGUS_RATE_LIMIT_UPLOAD_PER_MINUTE=10
ARGUS_RATE_LIMIT_SEARCH_PER_MINUTE=60

# --- Resource bounds ---------------------------------------------------------
ARGUS_ENGINE_MAX_CONCURRENCY=2
ARGUS_ANALYSIS_QUEUE_LIMIT=64
ARGUS_MAX_REQUEST_BYTES=4000000

# --- Feature flags (unknown flags are off; omit to leave everything on) ------
ARGUS_FEATURE_FLAGS=

# --- LLM coach (empty disables it; 'echo' is a local stub) -------------------
ARGUS_LLM_PROVIDER=
ARGUS_LLM_MODEL=
ARGUS_LLM_API_KEY=
ARGUS_LLM_BASE_URL=

ARGUS_MODELS_DIR=data/models
NEXT_PUBLIC_API_URL=http://localhost:8002
