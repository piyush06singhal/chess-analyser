# =============================================================================
# Caissa — test environment template.
#
# The test suite does NOT read this file: tests/conftest.py sets its own
# per-test SQLite database and a shallow engine depth. This template exists for
# running the *stack* in a test-shaped way (an isolated database, no external
# LLM, deterministic settings), and documents the values the suite relies on so
# they cannot drift.
# =============================================================================

ARGUS_ENV=test
ARGUS_LOG_LEVEL=WARNING
ARGUS_LOG_FORMAT=text

# A throwaway database. Never point this at anything holding real games.
ARGUS_DATABASE_URL=postgresql+psycopg2://argus:argus@localhost:5434/argus_test
ARGUS_REDIS_URL=redis://:argus-dev@localhost:6380/15

# Shallow, fast, deterministic searches. The engine suite records its own
# baseline; tests that need real depth are marked and run separately.
ARGUS_ENGINE_DEPTH=6
ARGUS_ENGINE_MULTIPV=2
ARGUS_ANALYSIS_PROFILE=fast

# No external services: the coach is disabled and no key is present, so a test
# can never reach a paid provider by accident.
ARGUS_LLM_PROVIDER=
ARGUS_LLM_MODEL=
ARGUS_LLM_API_KEY=

# Open mode keeps the existing single-user tests valid; the auth tests set keys
# explicitly through the app state.
ARGUS_API_KEYS=

# Bounds are small so the resource-gate tests can exhaust a bucket in one
# paragraph of code.
ARGUS_ENGINE_MAX_CONCURRENCY=1
ARGUS_ANALYSIS_QUEUE_LIMIT=2

ARGUS_MODELS_DIR=data/models
NEXT_PUBLIC_API_URL=http://localhost:8002