[TEMPLATE]
# =============================================================================
# Caissa — environment configuration template
# Copy to .env for local development. Never commit real secrets.
#
# Every setting the API reads is prefixed ARGUS_ (see apps/api/argus_api/config.py).
# A value not listed here simply takes its default; this file documents the ones
# a deployment normally sets.
#
# Per-environment templates live next to this file:
#   .env.development.example   .env.test.example
#   .env.staging.example       .env.production.example
# Validate the one you are deploying with:
#   python scripts/validate_config.py --environment <env>
# =============================================================================

# ---- Application ----
ARGUS_ENV=development                # development | test | staging | production
ARGUS_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
ARGUS_LOG_FORMAT=text                # text | json (use json in production)

# ---- API ----
ARGUS_API_HOST=0.0.0.0
ARGUS_API_PORT=8002                  # local uvicorn port (keep clear of other services)
ARGUS_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3100"]

# ---- Docker Compose host ports ----
# Host-side port mappings; containers always use the standard ports internally.
API_HOST_PORT=8002
WEB_HOST_PORT=3100                    # 3001 is commonly taken (e.g. Grafana)
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6380

# ---- Database (PostgreSQL) ----
# Local Docker Compose default (host port from POSTGRES_HOST_PORT). The API uses
# a sync SQLAlchemy engine, so the psycopg2 driver scheme is required. For
# Supabase, use the connection pooler URI with the same scheme. Empty selects
# SQLite for local development.
ARGUS_DATABASE_URL=postgresql+psycopg2://argus:argus@localhost:5434/argus

# ---- Redis (caching; optional - the API degrades gracefully without it) ----
# The compose Redis requires a password (REDIS_PASSWORD below); the URL must
# carry it. The API reports the real connection state and degrades without it.
REDIS_PASSWORD=argus-dev
ARGUS_REDIS_URL=redis://:argus-dev@localhost:6380/0

# ---- Stockfish engine ----
# Leave path empty to auto-detect stockfish on PATH / common install locations.
ARGUS_STOCKFISH_PATH=
ARGUS_ENGINE_DEPTH=12                 # depth-based search limit
ARGUS_ENGINE_MULTIPV=3                # root moves held in one search (alternatives)
ARGUS_ENGINE_TIMEOUT_SECONDS=30
ARGUS_ENGINE_THREADS=1
ARGUS_ENGINE_HASH_MB=256
ARGUS_ENGINE_MOVETIME_MS=0            # >0 switches to time-based search

# ---- Analysis profile ----
ARGUS_ANALYSIS_PROFILE=standard       # fast | standard | deep
ARGUS_ANALYSIS_MULTIPV=3

# ---- Player intelligence sample thresholds ----
# These are part of the product's honesty contract: raising them makes ARGUS
# claim less, lowering them makes it claim more from the same games.
ARGUS_PLAYER_MIN_GAMES_FOR_PROFILE=2
ARGUS_PLAYER_MIN_GAMES_FOR_TENDENCY=20
ARGUS_PLAYER_MIN_GAMES_FOR_STRONG_CLAIM=50
ARGUS_PLAYER_PROFILE_MAX_GAMES=500

# ---- Game sources (public, key-less read APIs) ----
# Chess.com and Lichess both read a player's games by username and store
# nothing until a specific game is imported. Only the base URL, the month
# window and the identifying User-Agent are configurable. No credentials exist.
ARGUS_CHESSCOM_BASE_URL=https://api.chess.com/pub
ARGUS_CHESSCOM_ARCHIVE_MONTHS=3
ARGUS_LICHESS_BASE_URL=https://lichess.org
ARGUS_LICHESS_ARCHIVE_MONTHS=3

# ---- Authentication (Phase 15) ----
# API keys as `key:caller:role` entries, comma-separated. EMPTY means the
# deployment is *open*: every request is the 'local' caller. That is fine for
# local development and refused in production by scripts/validate_config.py.
ARGUS_API_KEYS=

# ---- Rate limits (Phase 15; per caller, per minute; 0 disables a bucket) ----
ARGUS_RATE_LIMIT_WINDOW_SECONDS=60
ARGUS_RATE_LIMIT_ANALYSIS_PER_MINUTE=30
ARGUS_RATE_LIMIT_IMPORT_PER_MINUTE=30
ARGUS_RATE_LIMIT_COACH_PER_MINUTE=20
ARGUS_RATE_LIMIT_UPLOAD_PER_MINUTE=10
ARGUS_RATE_LIMIT_SEARCH_PER_MINUTE=60

# ---- Request & engine resource bounds (Phase 15) ----
ARGUS_MAX_REQUEST_BYTES=4000000      # hard cap on a request body (0 disables)
ARGUS_ENGINE_MAX_CONCURRENCY=2       # concurrent engine-using analyses per process
ARGUS_ANALYSIS_QUEUE_LIMIT=64        # analyses queued before new work is refused (503)

# ---- Feature flags (Phase 15) ----
# Server-controlled switches. Format: name=true,name2=false. An unknown flag is
# off; a disabled surface returns 404 rather than advertising itself.
# Known flags: coach, live_chess, graph, predictions, scenarios, training.
ARGUS_FEATURE_FLAGS=

# ---- LLM coach (AI agent) ----
# Provider: openai | anthropic | groq | echo. Empty disables the coach; /api/coach/ask
# still answers from tools and says it cannot write prose. "echo" is a
# self-identifying development provider with no external calls. Keys are read
# from the environment only - never commit real keys, never expose them to the
# browser. Values are never echoed by /health or /ready.
ARGUS_LLM_PROVIDER=
ARGUS_LLM_MODEL=                     # provider default when empty
ARGUS_LLM_API_KEY=
ARGUS_LLM_BASE_URL=                  # optional proxy/gateway override
ARGUS_LLM_TEMPERATURE=0.3
ARGUS_LLM_MAX_OUTPUT_TOKENS=1200
ARGUS_LLM_TIMEOUT_SECONDS=60

# ---- ML model store ----
# Trained artifacts (joblib) + versioned metadata live here. No model has passed
# its production gate yet, so predictions stay unavailable by design.
ARGUS_MODELS_DIR=data/models

# ---- Frontend ----
# Must match the name read by apps/web/src/lib/api.ts (NEXT_PUBLIC_API_URL).
# Baked into the production build at build time.
NEXT_PUBLIC_API_URL=http://localhost:8002

# Public canonical origin for metadata (Open Graph, sitemap). Unset means no
# domain is advertised and the sitemap stays empty rather than guessing a host.
NEXT_PUBLIC_SITE_URL=

# Optional Web Vitals beacon target. Unset means metrics are logged in
# development only and nothing is sent anywhere; the app never phones home.
NEXT_PUBLIC_VITALS_ENDPOINT=
