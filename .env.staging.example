# =============================================================================
# Caissa — staging environment template.
#
# Staging is production-shaped but not production: real PostgreSQL, real auth,
# JSON logs, an isolated database and its own secrets. It exists to run the
# release candidate, the load and smoke tests, and the migration dry run before
# anything touches production. Keep staging's secrets DIFFERENT from production.
# =============================================================================

ARGUS_ENV=staging
ARGUS_LOG_LEVEL=INFO
ARGUS_LOG_FORMAT=json

# --- API ---------------------------------------------------------------------
ARGUS_API_HOST=0.0.0.0
ARGUS_API_PORT=8000
ARGUS_CORS_ORIGINS=https://staging.argus.example

# --- Database / cache --------------------------------------------------------
ARGUS_DATABASE_URL=postgresql+psycopg2://argus:CHANGE_ME@staging-db:5432/argus
ARGUS_REDIS_URL=redis://:CHANGE_ME@staging-redis:6379/0

# --- Engine ------------------------------------------------------------------
ARGUS_STOCKFISH_PATH=/usr/games/stockfish
ARGUS_ENGINE_DEPTH=14
ARGUS_ENGINE_MULTIPV=3
ARGUS_ENGINE_THREADS=2
ARGUS_ENGINE_HASH_MB=512
ARGUS_ANALYSIS_PROFILE=standard

# --- Auth (required outside development) -------------------------------------
# Format: key:caller:role,key:caller:role . Generate with a password manager;
# never reuse production keys here.
ARGUS_API_KEYS=CHANGE_ME_STAGING_KEY:staging-operator:operator

# --- Rate limits / resource bounds -------------------------------------------
ARGUS_RATE_LIMIT_ANALYSIS_PER_MINUTE=30
ARGUS_RATE_LIMIT_IMPORT_PER_MINUTE=30
ARGUS_RATE_LIMIT_COACH_PER_MINUTE=20
ARGUS_RATE_LIMIT_UPLOAD_PER_MINUTE=10
ARGUS_RATE_LIMIT_SEARCH_PER_MINUTE=60
ARGUS_ENGINE_MAX_CONCURRENCY=2
ARGUS_ANALYSIS_QUEUE_LIMIT=64
ARGUS_MAX_REQUEST_BYTES=4000000

# --- Feature flags -----------------------------------------------------------
ARGUS_FEATURE_FLAGS=

# --- LLM coach (real provider; 'echo' is refused outside development) --------
ARGUS_LLM_PROVIDER=openai
ARGUS_LLM_MODEL=
ARGUS_LLM_API_KEY=CHANGE_ME_STAGING_LLM_KEY
ARGUS_LLM_BASE_URL=

ARGUS_MODELS_DIR=/app/data/models
NEXT_PUBLIC_API_URL=https://staging-api.argus.example
