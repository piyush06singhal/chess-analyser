# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Node / Next.js ----
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts
# Auto-generated by `next dev` (agent rules); not part of the source tree.
apps/web/AGENTS.md
# Playwright output (generated by the browser suite; never committed)
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/

# ---- Environment & secrets ----
.env
.env.local
.env.*.local
*.pem

# ---- Local databases ----
*.db
*.sqlite3

# ---- Engine binaries (installed/downloaded locally, never committed) ----
engine/stockfish/*
!engine/stockfish/.gitkeep

# ---- Data artifacts (generated layers stay out of git) ----
# Every layer below is regenerable output (see data/README.md). They also embed
# absolute build-host paths and, for user-scoped builds, private game data, so
# they must never be committed.
data/raw/*
data/processed/*
data/normalized/*
data/experiments/*
data/labels/*
data/positions/*
data/validated/*
data/engine_analysis/*
data/features/*
data/train/*
data/validation/*
data/test/*
data/models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/normalized/.gitkeep
!data/experiments/.gitkeep
!data/features/.gitkeep
!data/models/.gitkeep
!data/README.md

# ---- Generated evaluation reports (output, not source) ----
evaluation/reports/

# ---- OS / IDE / tooling artifacts ----
.DS_Store
.idea/
*.swp
.freebuff/

# ---- Logs ----
*.log
logs/
